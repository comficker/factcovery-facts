{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.comficker/factcovery-facts",
  "title": "Factcovery Facts",
  "description": "500+ short, sourced fun facts: random fact, fact of the day, search and facts by topic.",
  "websiteUrl": "https://www.factcovery.com",
  "repository": {
    "url": "https://github.com/comficker/factcovery-facts",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "factcovery-facts",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
